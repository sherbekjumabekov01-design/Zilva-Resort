# ===================================================================
# 🌲 ZILVA RESORT & SPA — PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================================

# 1. Database Configuration
POSTGRES_DB=zilva_resort
POSTGRES_USER=zilva_admin
POSTGRES_PASSWORD=your_strong_postgres_password_here_2026!
DB_HOST=db
DB_PORT=5432

# 2. ASP.NET Core Backend
ASPNETCORE_ENVIRONMENT=Production
UsePostgres=true
ConnectionStrings__PostgreSqlConnection=Host=db;Port=5432;Database=zilva_resort;Username=zilva_admin;Password=your_strong_postgres_password_here_2026!

# 3. Security & Admin
JWT_SECRET=ZilvaResort_SuperSecret_JwtKey_2026_MountainLuxury_Min32Chars!
ADMIN_PIN=7788

# 4. Telegram Notification Bot (Optional for Live Alerts)
TELEGRAM_BOT_TOKEN=7123456789:AAExampleTelegramBotTokenHere
TELEGRAM_CHAT_ID=-1001234567890

# 5. Frontend Configuration
NODE_ENV=production
NEXT_PUBLIC_API_URL=/api
